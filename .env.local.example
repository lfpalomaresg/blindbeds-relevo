# Blindbeds Relevo — variables de entorno locales
# Copia este fichero a .env.local y rellena con los valores de TU proyecto Supabase
# (Dashboard → Project Settings → API y → Database). Nunca subas .env.local al repo.

# Públicas (van también a Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Privadas (solo en tu máquina; las usa scripts/setup-supabase-pro.sh)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_DB_PASSWORD=<database-password>
